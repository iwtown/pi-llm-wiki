# =============================================================================
# pi-llm-wiki — Environment Configuration
# =============================================================================
# Copy this file to .env (gitignored) and fill in your values.
# All vars are optional; defaults work out-of-box for wtown's WSL2 setup.

# ── Vault Paths ──────────────────────────────────────────────────────────────

# Path to Obsidian LLM-Wiki vault (default: /mnt/d/DB/Obsidian/LLM-Wiki)
# LLM_WIKI_VAULT=/path/to/your/vault

# Path to ZInBox clipping vault (default: /mnt/d/DB/Obsidian/ZInBox)
# LLM_WIKI_ZINBOX=/path/to/your/zinbox

# ── Primary LLM Provider (GLM) ──────────────────────────────────────────────

# API key for the primary extraction model
# ZHIPU_API_KEY=your_zhipu_api_key_here

# Provider model ID (default: glm-4-flash-250414)
# LLM_WIKI_EXTRACT_MODEL=glm-4-flash

# Provider API endpoint (default: https://open.bigmodel.cn/api/paas/v4/chat/completions)
# LLM_WIKI_EXTRACT_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# LLM call timeout in ms (default: 15000)
# LLM_WIKI_EXTRACT_TIMEOUT_MS=15000

# Max output tokens (default: 1000)
# LLM_WIKI_EXTRACT_MAX_TOKENS=1000

# Context characters to send (default: 4000)
# LLM_WIKI_EXTRACT_CONTEXT_CHARS=4000

# Temperature for extraction (default: 0.1)
# LLM_WIKI_EXTRACT_TEMPERATURE=0.1

# Temperature for distillation (default: 0.3)
# LLM_WIKI_DISTILL_TEMPERATURE=0.3

# Max concurrent API calls for batch processing (default: 3)
# LLM_WIKI_MAX_CONCURRENCY=3

# ── Fallback LLM Provider (DeepSeek) ────────────────────────────────────────

# API key for fallback extraction model (used when primary is congested)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Fallback model ID (default: deepseek-v4-flash)
# LLM_WIKI_FALLBACK_MODEL=deepseek-v4-flash

# Fallback API endpoint (default: https://api.deepseek.com/chat/completions)
# LLM_WIKI_FALLBACK_ENDPOINT=https://api.deepseek.com/chat/completions

# Fallback timeout in ms (default: 15000)
# LLM_WIKI_FALLBACK_TIMEOUT_MS=15000

# Fallback max tokens (default: 1000)
# LLM_WIKI_FALLBACK_MAX_TOKENS=1000
