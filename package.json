{
  "name": "pi-llm-wiki",
  "version": "1.0.0",
  "description": "Pi Agent LLM-Wiki knowledge management package. Provides 7 tools (ingest, query, compile, weave, lint, capture, reference) plus lifecycle hooks for Obsidian-based agent long-term memory.",
  "keywords": [
    "pi-package",
    "pi-agent",
    "extension",
    "obsidian",
    "llm-wiki",
    "knowledge-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iwtown/pi-llm-wiki.git"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/unit.test.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:pipeline": "LLM_WIKI_TEST_VAULT=/tmp/test-vault-llm-wiki tsx --test tests/pipeline.test.ts tests/changes.test.ts",
    "test:all": "LLM_WIKI_TEST_VAULT=/tmp/test-vault-llm-wiki tsx --test tests/*.test.ts",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:dry": "tsx scripts/run-pipeline.ts --dry-run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsx": "^4.0.0"
  }
}
